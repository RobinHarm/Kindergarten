@model IEnumerable<Kindergarten.Models.Children.ChildrenIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="create" asp-controller="Children" type="submit" class="btn btn-primary">Create</a>
</div>

<div class="h1">
Children
</div>
<form method="get">
<table class="table table-hover">
<thead>
<tr>
<th scope="col">Id</th>
<th scope="col">Group name</th>
<th scope="col">Children count</th>
<th scope="col">Kindergarten Name</th>
<th scope="col">Teacher Name</th>
<th scope="col">Created At</th>
<th scope="col">Modified At</th>
</tr>
</thead>
<tbody>
            @foreach (var children in Model)
                {
<tr>
<td>@rowNumber</td>
<td>@children.GroupName</td>
<td>@children.ChildrenCount</td>
<td>@children.KinderGartenName</td>
<td>@children.TeacherName</td>
<td>@children.CreatedAt</td>
<td>@children.UpdatedAt</td>
                <td>
                    <a asp-action="details" asp-controller="Children" asp-route-id="@children.Id" type="submit" class="btn btn-info">Details</a>
                    <a asp-action="update" asp-controller="Children" asp-route-id="@children.Id" type="submit" class="btn btn-secondary">Update</a>
                    <a asp-action="delete" asp-controller="Children" asp-route-id="@children.Id" type="submit" class="btn btn-danger">Delete</a>
                </td>
                       
</tr>
                    rowNumber++;
                }
</tbody>
</table>
</form>