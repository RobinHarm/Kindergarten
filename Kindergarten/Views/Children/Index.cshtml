@model IEnumerable<Kindergarten.Models.Children.ChildrenIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="create" asp-controller="Children" type="submit" class="btn btn-primary">Create</a>
</div>

<div class="h1">
Children
</div>
<form method="get">
<table class="table table-hover">
<thead>
<tr>
<th scope="col">Nr</th>
<th scope="col">GroupName</th>
<th scope="col">ChildrenCount</th>
<th scope="col">KinderGartenName</th>
<th scope="col">TeacherName</th>
<th scope="col">CreatedAt</th>
<th scope="col"></th>
</tr>
</thead>
<tbody>
            @foreach (var children in Model)
                {
<tr>
<td>@rowNumber</td>
<td>@children.GroupName</td>
<td>@children.ChildrenCount</td>
<td>@children.KinderGartenName</td>
<td>@children.TeacherName</td>
<td>@children.CreatedAt</td>
<td>@children.UpdatedAt</td>
                <td>
                    <a asp-action="details" asp-controller="Children" asp-route-id="@children.Id" type="submit" class="btn btn-info">Details</a>
                </td>
                       
</tr>
                    rowNumber++;
                }
</tbody>
</table>
</form>